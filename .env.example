# Nexlev Studio Internal Platform — Environment Configuration Example
# Copy to .env or export in your shell. Never commit real secrets to Git.

# Server Bind Address & Port (Default: loopback 127.0.0.1:4320 for safe local operation)
# Set NEXLEV_HOST=0.0.0.0 if exposing over LAN/Tailscale for internal team members
NEXLEV_HOST=127.0.0.1
NEXLEV_PORT=4320

# Optional Static API Token for API / MCP / CLI requests
# When set, API callers can pass header: X-Api-Token: <token> or Authorization: Bearer <token>
NEXLEV_API_TOKEN=

# Optional Comma-separated extra CORS origins (for LAN hostname or custom Chrome extension ID)
NEXLEV_CORS_ORIGINS=

# Optional External Provider API Keys (can also be configured in Web Settings -> data/.secrets.local.json)
YOUTUBE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# SQLite Database Path (Defaults to ./data/nexlev.sqlite)
# NEXLEV_SQLITE_PATH=./data/nexlev.sqlite
