{
  "manifest_version": 3,
  "name": "Nexlev Team Studio — YouTube Outlier & Idea Collector",
  "version": "2.0.0",
  "description": "Displays verified same-channel Outlier baselines, scenario RPM, and saves videos with full metadata directly to the shared Team Idea Library.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Nexlev Team Studio"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:3088/*",
    "http://127.0.0.1:3088/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
